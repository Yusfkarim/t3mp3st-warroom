# ── T3MP3ST War Room configuration ───────────────────────────────────────────
# Upstream framework (public). Pinned to the commit our patches target.
T3MP3ST_REPO="https://github.com/elder-plinius/T3MP3ST"
T3MP3ST_COMMIT="29824d5625ede419ac8cdae418c8f4c72c6270f7"
T3MP3ST_DIR="$HOME/t3mp3st"

# Local port
PORT=3333

# Brain: OpenCode FREE models (no API key, uses your OpenCode login)
OPENCODE_FREE_MODEL="opencode/space-bunny-free"
DEFAULT_MODEL="opencode::opencode/space-bunny-free"
# Other free options you can switch DEFAULT_MODEL to:
#   opencode::opencode/mimo-v2.6-flash-free
#   opencode::opencode/glm-5.3-flash-free
#   opencode::opencode/deepseek-v4.1-flash-free

# Scan reports → Telegram bot  (OPTIONAL)
# Put real values in config.local.env (gitignored) — do NOT commit secrets here.
TG_BOT_TOKEN=""
TG_CHAT_ID=""
